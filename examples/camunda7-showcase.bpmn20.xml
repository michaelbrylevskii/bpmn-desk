<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:demo="urn:bpmn-desk:example" id="CamundaDefinitions" targetNamespace="urn:bpmn-desk:camunda7">
  <bpmn:error id="ArchiveError" name="Archive unavailable" errorCode="ARCHIVE_UNAVAILABLE" camunda:errorMessage="Archive request failed" />
  <bpmn:process id="OrderProcess" name="Order approval · Camunda 7" isExecutable="true" camunda:historyTimeToLive="30" camunda:versionTag="1.0" camunda:candidateStarterGroups="sales">
    <bpmn:extensionElements><camunda:properties><camunda:property name="category" value="example" /></camunda:properties></bpmn:extensionElements>
    <bpmn:startEvent id="OrderStart" name="Request received" camunda:initiator="initiator">
      <bpmn:outgoing>StartReview</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="ReviewOrder" name="Review order" camunda:assignee="${initiator}" camunda:candidateGroups="managers" camunda:dueDate="${dueDate}" camunda:followUpDate="${followUpDate}" camunda:priority="50">
      <bpmn:extensionElements>
        <camunda:taskListener event="create" delegateExpression="${reviewListener}"><camunda:field name="channel" stringValue="desktop" /></camunda:taskListener>
        <camunda:formData>
          <camunda:formField id="approved" label="Approved" type="boolean" defaultValue="true"><camunda:validation><camunda:constraint name="required" /></camunda:validation></camunda:formField>
          <camunda:formField id="priority" label="Priority" type="enum" defaultValue="normal"><camunda:value id="normal" name="Normal" /><camunda:value id="urgent" name="Urgent" /><camunda:properties><camunda:property id="hint" value="Select processing priority" /></camunda:properties></camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>StartReview</bpmn:incoming><bpmn:outgoing>ReviewArchive</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ArchiveOrder" name="Archive order" camunda:type="external" camunda:topic="archive-order" camunda:taskPriority="100" camunda:asyncBefore="true" camunda:asyncAfter="false" camunda:exclusive="false" demo:owner="example-team">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="payload"><camunda:map><camunda:entry key="orderId">${orderId}</camunda:entry><camunda:entry key="tags"><camunda:list><camunda:value>approved</camunda:value><camunda:value>desktop</camunda:value></camunda:list></camunda:entry></camunda:map></camunda:inputParameter>
          <camunda:outputParameter name="archiveId">${resultId}</camunda:outputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="end" delegateExpression="${auditListener}"><camunda:field name="category"><camunda:string>archive</camunda:string></camunda:field></camunda:executionListener>
        <camunda:errorEventDefinition id="ArchiveFailure" errorRef="ArchiveError" expression="${externalTask.errorMessage != null}" />
        <camunda:failedJobRetryTimeCycle>R3/PT5M</camunda:failedJobRetryTimeCycle>
        <demo:metadata demo:retention="standard"><demo:label>Public sample</demo:label></demo:metadata>
      </bpmn:extensionElements>
      <bpmn:incoming>ReviewArchive</bpmn:incoming><bpmn:outgoing>ArchiveDecision</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="DetermineRoute" name="Determine route" camunda:decisionRef="orderRoute" camunda:decisionRefBinding="versionTag" camunda:decisionRefVersionTag="1.0" camunda:mapDecisionResult="singleEntry" camunda:resultVariable="route">
      <bpmn:incoming>ArchiveDecision</bpmn:incoming><bpmn:outgoing>DecisionCall</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:callActivity id="FulfillOrder" name="Fulfill order" calledElement="FulfillmentProcess" camunda:calledElementBinding="versionTag" camunda:calledElementVersionTag="1.0" camunda:calledElementTenantId="${execution.tenantId}">
      <bpmn:extensionElements><camunda:in businessKey="${execution.processBusinessKey}" /><camunda:in source="orderId" target="orderId" /><camunda:out source="shipmentId" target="shipmentId" local="false" /></bpmn:extensionElements>
      <bpmn:incoming>DecisionCall</bpmn:incoming><bpmn:outgoing>CallScript</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:scriptTask id="PrepareSummary" name="Prepare summary" scriptFormat="javascript" camunda:resultVariable="summary"><bpmn:incoming>CallScript</bpmn:incoming><bpmn:outgoing>ScriptEnd</bpmn:outgoing><bpmn:script>"Order " + execution.getVariable("orderId")</bpmn:script></bpmn:scriptTask>
    <bpmn:endEvent id="OrderEnd" name="Order complete"><bpmn:incoming>ScriptEnd</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="StartReview" sourceRef="OrderStart" targetRef="ReviewOrder" />
    <bpmn:sequenceFlow id="ReviewArchive" sourceRef="ReviewOrder" targetRef="ArchiveOrder" />
    <bpmn:sequenceFlow id="ArchiveDecision" sourceRef="ArchiveOrder" targetRef="DetermineRoute" />
    <bpmn:sequenceFlow id="DecisionCall" sourceRef="DetermineRoute" targetRef="FulfillOrder" />
    <bpmn:sequenceFlow id="CallScript" sourceRef="FulfillOrder" targetRef="PrepareSummary" />
    <bpmn:sequenceFlow id="ScriptEnd" sourceRef="PrepareSummary" targetRef="OrderEnd" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="CamundaDiagram"><bpmndi:BPMNPlane id="CamundaPlane" bpmnElement="OrderProcess">
    <bpmndi:BPMNShape id="OrderStart_di" bpmnElement="OrderStart"><dc:Bounds x="80" y="202" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="ReviewOrder_di" bpmnElement="ReviewOrder"><dc:Bounds x="190" y="180" width="100" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="ArchiveOrder_di" bpmnElement="ArchiveOrder"><dc:Bounds x="365" y="180" width="100" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="DetermineRoute_di" bpmnElement="DetermineRoute"><dc:Bounds x="540" y="180" width="100" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="FulfillOrder_di" bpmnElement="FulfillOrder"><dc:Bounds x="715" y="180" width="100" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="PrepareSummary_di" bpmnElement="PrepareSummary"><dc:Bounds x="890" y="180" width="100" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="OrderEnd_di" bpmnElement="OrderEnd"><dc:Bounds x="1070" y="202" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="StartReview_di" bpmnElement="StartReview"><di:waypoint x="116" y="220" /><di:waypoint x="190" y="220" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="ReviewArchive_di" bpmnElement="ReviewArchive"><di:waypoint x="290" y="220" /><di:waypoint x="365" y="220" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="ArchiveDecision_di" bpmnElement="ArchiveDecision"><di:waypoint x="465" y="220" /><di:waypoint x="540" y="220" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="DecisionCall_di" bpmnElement="DecisionCall"><di:waypoint x="640" y="220" /><di:waypoint x="715" y="220" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="CallScript_di" bpmnElement="CallScript"><di:waypoint x="815" y="220" /><di:waypoint x="890" y="220" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="ScriptEnd_di" bpmnElement="ScriptEnd"><di:waypoint x="990" y="220" /><di:waypoint x="1070" y="220" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
