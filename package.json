{
  "name": "bpmn-desk",
  "version": "0.2.0",
  "description": "Локальный BPMN-редактор с поддержкой Flowable и Camunda 7",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": "BPMN Desk contributors",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/playwright.mjs test",
    "test:extra": "node scripts/test-extra.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "package:linux": "npm run build:icon && npm run build && node scripts/package.mjs --linux AppImage",
    "package:windows": "npm run build:icon && npm run build && node scripts/package.mjs --win --x64",
    "package:windows:docker": "npm run build:icon && npm run build && node scripts/package-windows-docker.mjs",
    "setup:electron": "node scripts/setup-electron.mjs",
    "setup:e2e": "node scripts/playwright.mjs install chromium",
    "build:icon": "node scripts/build-icon.mjs",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "validate:flowable": "node scripts/validate-flowable.mjs",
    "validate:flowable:extra": "node scripts/validate-flowable.mjs --extra",
    "validate:camunda": "node scripts/validate-camunda.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.14",
    "@lezer/xml": "1.0.6",
    "@xmldom/xmldom": "0.9.12",
    "bpmn-js": "18.31.0",
    "bpmn-moddle": "10.3.1",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "cross-spawn": "7.0.6",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "desktopName": "bpmn-desk.desktop",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
